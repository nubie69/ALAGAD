ms\": [\n    {\n      \"id\": \"69bf9b03355a381b553ea9da\",\n      \"type\": \"Service\",\n      \"canonical_name\": \"Claiming of Examination Result\",\n      \"aliases\": \"Claiming of Examination Result; COER; Admission and Testing Unit (ATU)\",\n      \"location\": \"Admission and Testing Unit (ATU)\",\n      \"last_updated\": \"2026-03-30T14:33:42.877Z\",\n      \"source\": \"services\",\n      \"content\": \"Service: Claiming of Examination Result. Description: This refers to the release of the examinee's admission test result. Office or Division: Admission and Testing Unit (ATU) Classification: Simple Type of transaction: G2C-Government to Citizen Who may avail: BukSU-CAT, COL & GPAT Takers. Requirements: . Process Steps: WHERE TO SECURE:; Admission account at admissions.buksu.edu.ph; STEP 1:; CLIENT STEPS: Login to admissions.buksu.edu.ph; ACTION AGENCY: Upload to admissions system 15 working days after the last conduct of BukSU-CAT/COL/GPAT.; FEES TO BE PAID: None; PROCESSING TIME: 5 minutes; PERSON RESPONSIBLE: Angel Sweet S. Berdiguel (ATU Psychometrician). Department: . Office: Admission and Testing Unit (ATU)\",\n      \"similarity\": 1,\n      \"rerank_score\": 1,\n      \"rerank_signals\": {\n        \"exactCanonical\": true,\n        \"exactAlias\": false,\n        \"phraseCanonical\": true,\n        \"phraseAlias\": false,\n        \"sameTypeBoost\": 0,\n        \"stalenessPenalty\": 0\n      },\n      \"structured\": {\n        \"id\": \"69bf9b03355a381b553ea9da\",\n        \"name\": \"Claiming of Examination Result\",\n        \"requirements\": [],\n        \"details\": \"This refers to the release of the examinee's admission test result.\\nOffice or Division: Admission and Testing  Unit (ATU)\\nClassification: Simple\\nType of transaction: G2C-Government to Citizen\\nWho may avail: BukSU-CAT, COL & GPAT Takers\",\n        \"process_steps\": [\n          \"WHERE TO SECURE:\",\n          \"Admission account at admissions.buksu.edu.ph\",\n          \"STEP 1:\",\n          \"CLIENT STEPS: Login to admissions.buksu.edu.ph\",\n          \"ACTION AGENCY: Upload to admissions system 15 working days after the last conduct of BukSU-CAT/COL/GPAT.\",\n          \"FEES TO BE PAID: None\",\n          \"PROCESSING TIME: 5 minutes\",\n          \"PERSON RESPONSIBLE: Angel Sweet S. Berdiguel (ATU Psychometrician)\"\n        ],\n        \"contact\": null,\n        \"last_updated\": \"2026-03-30T14:33:42.877Z\"\n      }\n    }\n  ]\n}\n\nInstructions:\n- Use only facts present in CONTEXT_JSON.\n- If missing, return the exact no-info sentence.\n- Return exactly one answer with professional grammar and natural phrasing.\n- Keep the answer concise and factual.\n- Do not include headings or labels (e.g., \"Answer:\", \"User Query:\", \"Context:\").","model_response":"You can claim your examination result by logging into your admission account at admissions.buksu.edu.ph. The results are uploaded to the admissions system 15 working days after the last conduct of the BukSU-CAT, COL, or GPAT. There are no fees to be paid, and the processing time is approximately 5 minutes.","response_text":"You can claim your examination result by logging into your admission account at admissions.buksu.edu.ph. The results are uploaded to the admissions system 15 working days after the last conduct of the BukSU-CAT, COL, or GPAT. There are no fees to be paid, and the processing time is approximately 5 minutes.","model_response_language":"english","final_response_language":"english","translation_steps":{"query":{"text":"Where can I claim my Examination Result?","sourceLanguage":"english","targetLanguage":"english","translated":false,"method":"none"},"response":{"text":"You can claim your examination result by logging into your admission account at admissions.buksu.edu.ph. The results are uploaded to the admissions system 15 working days after the last conduct of the BukSU-CAT, COL, or GPAT. There are no fees to be paid, and the processing time is approximately 5 minutes.","sourceLanguage":"english","targetLanguage":"english","translated":false,"method":"none"}},"retrieval_mode":"exact_fallback","vector_db":"in-memory-cosine","embedding_model":"hash-embedding-v1","type_filters":["Service"],"fallback":{"sql":"SELECT * FROM items WHERE canonical_name = ? OR aliases LIKE ? LIMIT 5","params":["claim examination result","%claim examination result%"],"matches":[{"id":"69bf9b03355a381b553ea9da","record_id":"69bf9b03355a381b553ea9da","type":"Service","canonical_name":"Claiming of Examination Result","aliases":"Claiming of Examination Result; COER; Admission and Testing Unit (ATU)","location":"Admission and Testing Unit (ATU)","last_updated":"2026-03-30T14:33:42.877Z","last_indexed":"2026-04-06T15:12:31.879Z","deactivated":false,"source":"services","content":"Service: Claiming of Examination Result. Description: This refers to the release of the examinee's admission test result. Office or Division: Admission and Testing Unit (ATU) Classification: Simple Type of transaction: G2C-Government to Citizen Who may avail: BukSU-CAT, COL & GPAT Takers. Requirements: . Process Steps: WHERE TO SECURE:; Admission account at admissions.buksu.edu.ph; STEP 1:; CLIENT STEPS: Login to admissions.buksu.edu.ph; ACTION AGENCY: Upload to admissions system 15 working days after the last conduct of BukSU-CAT/COL/GPAT.; FEES TO BE PAID: None; PROCESSING TIME: 5 minutes; PERSON RESPONSIBLE: Angel Sweet S. Berdiguel (ATU Psychometrician). Department: . Office: Admission and Testing Unit (ATU)"},{"id":"69bf72bb355a381b553ea96b","record_id":"69bf72bb355a381b553ea96b","type":"Service","canonical_name":"Entrance Examination Application for Incoming 1st Year Students & Transferees","aliases":"Entrance Examination Application for Incoming 1st Year Students & Transferees; EEAFI1YS&T; Admission and Testing Unit (ATU)","location":"Admission and Testing Unit (ATU)","last_updated":"2026-03-30T15:09:10.745Z","last_indexed":"2026-04-06T15:12:31.879Z","deactivated":false,"source":"services","content":"Service: Entrance Examination Application for Incoming 1st Year Students & Transferees. Description: This refers to the service of processing admission test requirements and plotting of examination schedule for Senior High School, ALS graduates and Transferees who have the intention to enroll in any undergraduate programs of the university. Office or Division: Admission and Testing Unit (ATU) Classification: Complex Type of Transaction: G2C- Government to Citizen Who may avail: High School Graduates, Transferees and ALS Graduates. Requirements: -2X2 picture with white background; -Scanned copy of Documentary Requirement:; a. For Senior High School Graduates: Report Card/Certification as part of the graduating class signed by the Adviser/School Head; b. For Transferees: Scanned copy of Honorable Dismissal and Scanned copy of Transcript of Records; -For ALS Completer: Scanned copy of test result and Report Card for ALS indicating eligibility to enroll in Tertiary Education Institution. Process Steps: WHERE TO SECURE:; Photo studio/Camera/Smart phones; School previously attended; Alternative Learning System community learning centers: ALS facilitator; STEP 1:; CLIENT STEPS: Access admissions.buksu.edu.ph on a browser and click \"Register\" or \"Login\"; AGENCY ACTION: The admission in-charge coordinates with the Data Center to open the application link for BukSU-CAT; FEES TO BE PAID: None; PROCESSING TIME: 5 minutes; PERSON RESPONSIBLE: Mark G. Ochavillo (Document Controller); STEP 2:; CLIENT STEPS: Register an active email address and create a password. Read the privacy and terms agreement to next steps; AGENCY ACTION: An Automated privacy and terms agreement will notify the client and request their consent for BukSU ATU to access their personal information. This ensures compliance with data and privacy laws and allows to provide academic and administrative services.; FEES TO BE PAID: None; PROCESSING TIME: 5 minutes; PERSON RESPONSIBLE: Mark G. Ochavillo (Document Controller); STEP 3:; CLIENT STEPS: Access Gmail inbox to activate admission account; AGENCY ACTION: The ATU sends automated email of activation link to the client; FEES TO BE PAID: None; PROCESSING TIME: 2 minutes; PERSON RESPONSIBLE: Mark G. Ochavillo (Document Controller); STEP 4:; CLIENT STEPS: Proceed to complete the online application by providing the required information and submission of documentary requirement.; AGENCY ACTION: The Admission website prompts the client to provide the necessary information and uploaded the required documents to complete the application process.; FEES TO BE PAID: None; PROCESSING TIME: 10 minutes; PERSON RESPONSIBLE: Mark G. Ochavillo (Document Controller); STEP 5:; CLIENT STEPS: Proceed to select date and time of the admission test.; AGENCY ACTION: The admission in-charge manages and opens the examination schedules for applicants; FEES TO BE PAID: None; PROCESSING TIME: 5 minutes; PERSON RESPONSIBLE: Mark G. Ochavillo (Document Controller); STEP 6:; CLIENT STEPS: Submit the accomplished online application for evaluation; AGENCY ACTION: The admission in-charge evaluates the applications. (Evaluation is done per testing schedule); FEES TO BE PAID: None; PROCESSING TIME: 5 minutes; PERSON RESPONSIBLE: Mark G. Ochavillo (Document Controller); TOTAL PROCESSING TIME: 32 minutes. Department: . Office: Admission and Testing Unit (ATU)"},{"id":"69bf9864355a381b553ea98f","record_id":"69bf9864355a381b553ea98f","type":"Service","canonical_name":"Conduct of Entrance Examination for Incoming College Students","aliases":"Conduct of Entrance Examination for Incoming College Students; COEEFICS; Admission and Testing Unit (ATU)","location":"Admission and Testing Unit (ATU)","last_updated":"2026-03-30T15:08:59.659Z","last_indexed":"2026-04-06T15:12:31.879Z","deactivated":false,"source":"services","content":"Service: Conduct of Entrance Examination for Incoming College Students. Description: This refers to the actual conduct of admission test of which the result shall serve as pre-requisite and basis for enrollment to any programs prescribed by the college offering the course. Office or Division: Admission and Testing Unit (ATU) Classification: Simple Type of Transaction: G2C-Government to Citizen Who may avail: High School Graduates; Transferees & Returnees; ALS Graduates; and Second Courses. Requirements: -Printed Test Permit (1 printed copy); -Printed Application Form (1 printed copy). Process Steps: WHERE TO SECURE:; Admission account at admissions.buksu.edu.ph; STEP 1:; CLIENT STEPS: Present printed Test Permit and Application Form; AGENCY ACTION: Verify identification on the test permit and Application form presented. Distributes Test Booklets and Answer Sheets and administers examination; FEES TO BE PAID: None; PROCESSING TIME: 2 hours; PERSON RESPONSIBLE: Angel Sweet S. Berdiguel (ATU Psychometrician); STEP 2:; CLIENT STEPS: Submit accomplished examination papers and sign attendance sheet; AGENCY ACTION: Collects answer sheets and retrieves test booklets; facilitates signing of attendance sheets; FEES TO BE PAID: None; PROCESSING TIME: 5 minutes; PERSON RESPONSIBLE: Angel Sweet S. Berdiguel (ATU Psychometrician); TOTAL PROCESSING TIME: 2 hours and 5 minutes. Department: . Office: Admission and Testing Unit (ATU)"},{"id":"69b81d756915f5fd64f7d74d","record_id":"69b81d756915f5fd64f7d74d","type":"Service","canonical_name":"EXEMPTION SLIP","aliases":"EXEMPTION SLIP; ES; Student Leadership & Development Unit (SLEDEVU)","location":"Student Leadership & Development Unit (SLEDEVU)","last_updated":"2026-03-30T15:08:47.946Z","last_indexed":"2026-04-06T15:12:31.878Z","deactivated":false,"source":"services","content":"Service: EXEMPTION SLIP. Description: The exemption slip serves as a crucial tool in the university’s administrative framework, aiming to efficiently manage and formalize the process of excusing students for valid reasons. Aligned with established policies and procedures, it provides a transparent and fair mechanism for temporary absences from classes, events, or requirements. Office or Division: Student Leadership & Development Unit Classification: Simple Type of Transaction: G2C-Government to Citizen Who may avail: All enrolled students of Bukidnon State University. Requirements: -Validated Student Identification Card; -Letter request (Attachment to the declared reason for exemption). Process Steps: WHERE TO SECURE:; University Press (Refer to process on Securing School Identification Card); STEP 1: SUBMIT REQUIREMENTS; CLIENT STEPS: Present Identification Card & Printed Letter request with attachment.; AGENCY ACTION: Verify documents presented; FEES TO BE PAID: None; PROCESSING TIME: 1 minute; PERSON RESPONSIBLE: Aaron Rod O. Corpuz / Jarey Mae E. Baylosis (SLeDevU Staff); STEP 2: RECORD AND ISSUANCE; CLIENT STEPS: Sign the Logbook.; AGENCY ACTION: Issue Exemption Slip; FEES TO BE PAID: None; PROCESSING TIME: 1 minute; PERSON RESPONSIBLE: Aaron Rod O. Corpuz / Jarey Mae E. Baylosis (SLeDevU Staff); STEP 3: PROVIDE FEEDBACK; CLIENT STEPS: Fill out the Customer Feedback Form /BOSES.; AGENCY ACTION: Receives and monitors filled-out Customer Feedback Form; FEES TO BE PAID: None; PROCESSING TIME: 1 minute; PERSON RESPONSIBLE: Aaron Rod O. Corpuz / Jarey Mae E. Baylosis (SLeDevU Staff); TOTAL Fees: None; TOTAL Processing Time: 3 Minutes. Department: . Office: Student Leadership & Development Unit (SLEDEVU)"}]}}
